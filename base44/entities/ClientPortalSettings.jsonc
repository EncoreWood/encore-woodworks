{
  "name": "ClientPortalSettings",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Linked project ID"
    },
    "client_email": {
      "type": "string",
      "description": "Client user email"
    },
    "client_name": {
      "type": "string",
      "description": "Client display name (copied from the attached contact)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "welcome_message": {
      "type": "string"
    },
    "show_status": {
      "type": "boolean",
      "default": true
    },
    "show_milestones": {
      "type": "boolean",
      "default": true
    },
    "show_timeline": {
      "type": "boolean",
      "default": true
    },
    "show_presentations": {
      "type": "boolean",
      "default": true
    },
    "show_documents": {
      "type": "boolean",
      "default": true
    },
    "show_photos": {
      "type": "boolean",
      "default": true
    },
    "show_financials": {
      "type": "boolean",
      "default": false
    },
    "show_messages": {
      "type": "boolean",
      "default": true
    },
    "show_tasks": {
      "type": "boolean",
      "default": true
    },
    "show_notes": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "project_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}