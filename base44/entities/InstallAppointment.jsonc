{
  "name": "InstallAppointment",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Install date"
    },
    "time": {
      "type": "string",
      "description": "Start time"
    },
    "project_id": {
      "type": "string",
      "description": "Reference to Project ID"
    },
    "project_name": {
      "type": "string",
      "description": "Project name"
    },
    "client_name": {
      "type": "string",
      "description": "Client name"
    },
    "address": {
      "type": "string",
      "description": "Install address"
    },
    "crew": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Crew members assigned to the whole event"
    },
    "tasks": {
      "type": "array",
      "description": "Task items on this install event, each optionally assigned to a team member",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "assignee": {
            "type": "string",
            "description": "Team member assigned to this task"
          },
          "done": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "default": []
    },
    "notes": {
      "type": "string",
      "description": "Install notes"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "scheduled"
    }
  },
  "required": [
    "date",
    "project_name"
  ]
}