{
  "name": "ShopZoneSOP",
  "type": "object",
  "properties": {
    "zone_id": {
      "type": "string",
      "description": "Reference to ShopFlowArea ID (null for type-level SOPs)"
    },
    "zone_type": {
      "type": "string",
      "description": "Zone type key for type-level SOPs (applies to all zones of this type when zone_id is null)"
    },
    "zone_name": {
      "type": "string",
      "description": "Zone (or type) name for reference"
    },
    "title": {
      "type": "string",
      "description": "SOP title"
    },
    "overview": {
      "type": "string",
      "description": "Short overview of the station/process"
    },
    "required_ppe": {
      "type": "array",
      "description": "Required PPE items",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "steps": {
      "type": "array",
      "description": "Ordered list of procedure steps (each {text, image_url})",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "common_mistakes": {
      "type": "string",
      "description": "Common mistakes to avoid"
    },
    "safety_notes": {
      "type": "string",
      "description": "Safety notes / warnings"
    },
    "training_video_url": {
      "type": "string",
      "description": "Optional training video URL"
    },
    "photos": {
      "type": "array",
      "description": "Reference photo URLs",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "title"
  ]
}