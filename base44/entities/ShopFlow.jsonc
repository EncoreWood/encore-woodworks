{
  "name": "ShopFlow",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Flow name"
    },
    "color": {
      "type": "string",
      "default": "blue",
      "description": "Preset color key"
    },
    "sequence": {
      "type": "string",
      "description": "JSON array of zone IDs in flow order",
      "default": "[]"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this flow is enabled"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "name"
  ]
}