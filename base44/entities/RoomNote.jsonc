{
  "name": "RoomNote",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Reference to Project ID"
    },
    "project_name": {
      "type": "string",
      "description": "Project name for reference"
    },
    "room_name": {
      "type": "string",
      "description": "Room name this note belongs to"
    },
    "note_text": {
      "type": "string",
      "description": "Client's side note text"
    },
    "author_name": {
      "type": "string",
      "description": "Name of the client who wrote the note"
    },
    "author_email": {
      "type": "string",
      "description": "Email of the client who wrote the note"
    },
    "replies": {
      "type": "array",
      "description": "Threaded replies to this note (admin responses visible to the client)",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "author_name": {
            "type": "string"
          },
          "author_email": {
            "type": "string"
          },
          "created_date": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "project_id",
    "room_name",
    "note_text"
  ]
}