{
  "name": "DashboardSettings",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "enum": [
        "stats",
        "projects",
        "google_sheet",
        "book_of_month",
        "portal_url",
        "today_projects",
        "pts_goals",
        "pacing"
      ],
      "enumColors": [
        "gray",
        "gray",
        "gray",
        "blue",
        "gray",
        "purple",
        "green",
        "yellow"
      ],
      "description": "Dashboard section name. today_projects holds a per-day project selection: {\"date\":\"YYYY-MM-DD\",\"ids\":[...]}. The pacing section holds the shop's daily pacing targets as JSON: {\"daily_target_points\":20,\"daily_minimum_points\":15,\"history\":[{\"from\":\"YYYY-MM-DD\",\"daily_target_points\":20,\"daily_minimum_points\":15}]} \u2014 the history keeps past days measured against the target they actually had."
    },
    "visible_to_users": {
      "type": "boolean",
      "default": true,
      "description": "Whether regular users can see this section"
    },
    "visible_to_admins": {
      "type": "boolean",
      "default": true,
      "description": "Whether admins can see this section"
    },
    "value": {
      "type": "string",
      "description": "Generic string value (e.g. book title, the published portal base URL for the portal_url section, or the JSON pacing targets)"
    }
  },
  "required": [
    "section"
  ]
}