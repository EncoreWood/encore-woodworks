{
  "name": "DashboardSettings",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "enum": [
        "stats",
        "projects",
        "google_sheet",
        "book_of_month",
        "portal_url",
        "today_projects"
      ],
      "enumColors": [
        "gray",
        "gray",
        "gray",
        "blue",
        "gray",
        "purple"
      ],
      "description": "Dashboard section name. today_projects holds a per-day project selection: {\"date\":\"YYYY-MM-DD\",\"ids\":[...]} so tomorrow starts fresh."
    },
    "visible_to_users": {
      "type": "boolean",
      "default": true,
      "description": "Whether regular users can see this section"
    },
    "visible_to_admins": {
      "type": "boolean",
      "default": true,
      "description": "Whether admins can see this section"
    },
    "value": {
      "type": "string",
      "description": "Generic string value (e.g. book title, or the published portal base URL for the portal_url section)"
    }
  },
  "required": [
    "section"
  ]
}