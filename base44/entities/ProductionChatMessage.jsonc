{
  "name": "ProductionChatMessage",
  "type": "object",
  "properties": {
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "user_name": {
      "type": "string",
      "description": "Sender's display name"
    },
    "user_email": {
      "type": "string",
      "description": "Sender's email"
    },
    "mentions": {
      "type": "array",
      "description": "Team members tagged in this message via @",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Tagged team member's name"
          },
          "email": {
            "type": "string",
            "description": "Tagged team member's email"
          }
        }
      }
    },
    "attachments": {
      "type": "array",
      "description": "Attached files and photos",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "File name"
          },
          "url": {
            "type": "string",
            "description": "File URL"
          },
          "type": {
            "type": "string",
            "enum": [
              "file",
              "photo"
            ],
            "description": "Attachment type"
          }
        }
      }
    },
    "action": {
      "type": "string",
      "description": "Legacy in-app action field. Automated system messages are no longer written to this entity \u2014 reminders go to the bell."
    },
    "task_id": {
      "type": "string",
      "description": "ID of the Task created from this message"
    },
    "task_summary": {
      "type": "string",
      "description": "Short summary of the created task (assignee and due date)"
    }
  },
  "required": [
    "message",
    "user_name"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    }
  }
}