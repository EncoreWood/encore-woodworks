{
  "name": "Bid",
  "type": "object",
  "properties": {
    "project_name": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "project_id": {
      "type": "string",
      "description": "Linked Project ID"
    },
    "template": {
      "type": "string",
      "enum": [
        "item",
        "room_based"
      ],
      "default": "item",
      "description": "Which estimate template this record uses: 'item' = the linear-foot / item-catalog estimate, 'room_based' = the room-priced proposal (rooms + options, no LF or catalog items)."
    },
    "cabinet_style": {
      "type": "string",
      "description": "Free-text cabinet style shown in the room-based proposal's job fields (the item template uses bid_type instead)"
    },
    "bid_type": {
      "type": "string",
      "enum": [
        "basic_euro",
        "high_end_euro",
        "basic_face_frame",
        "mid_face_frame",
        "high_end_face_frame"
      ]
    },
    "bid_mode": {
      "type": "string",
      "enum": [
        "plan",
        "onsite"
      ],
      "default": "plan",
      "description": "Whether this is a plan-based or onsite bid"
    },
    "plan_file_url": {
      "type": "string"
    },
    "plan_file_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "finalized",
        "sent"
      ],
      "default": "draft"
    },
    "estimate_status": {
      "type": "string",
      "enum": [
        "current",
        "outdated"
      ],
      "default": "current",
      "description": "Versioning status: exactly one estimate per project is 'current' \u2014 the active version shown in the project's Estimates list. Any previous estimate is flipped to 'outdated' (kept for reference, shown in the collapsed Outdated section)."
    },
    "estimated_by": {
      "type": "string",
      "description": "Name of the team member who provided the estimate"
    },
    "wood_species": {
      "type": "string"
    },
    "door_style": {
      "type": "string"
    },
    "handles": {
      "type": "string"
    },
    "drawerbox": {
      "type": "string"
    },
    "drawer_glides": {
      "type": "string"
    },
    "hinges": {
      "type": "string"
    },
    "include_plan_pages": {
      "type": "boolean",
      "default": true,
      "description": "Whether the client estimate includes the 'Plan Reference' section \u2014 flattened images of every plan page that carries highlights, so the client can see where their cabinets are located"
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "room_name": {
            "type": "string"
          },
          "cabinet_style": {
            "type": "string",
            "description": "Per-room cabinet style override (a BidPricingConfig style_key). If empty/null, the room inherits the bid-level default style (bid_type)."
          },
          "pricing_source": {
            "type": "string",
            "enum": [
              "ai",
              "plan_marks"
            ],
            "default": "ai",
            "description": "Whether this room's pricing comes from the AI takeoff estimate or from the user's manual plan marks"
          },
          "ai_items_snapshot": {
            "type": "array",
            "description": "Snapshot of the AI-estimate items captured when the room was switched to plan_marks, so the user can toggle back",
            "items": {
              "type": "object"
            }
          },
          "ceiling_height": {
            "type": "string",
            "description": "Ceiling height in inches"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "cabinet_category": {
                  "type": "string",
                  "description": "Category key (references a BidCategory.key). Free string since categories are user-managed."
                },
                "measure_type": {
                  "type": "string",
                  "enum": [
                    "lf",
                    "qty",
                    "sqft",
                    "percentage"
                  ]
                },
                "quantity": {
                  "type": "number"
                },
                "unit_price": {
                  "type": "number",
                  "description": "Snapshotted unit price captured when the item was added to this bid (or last refreshed via 'Update to Current Pricing'). Independent of later catalog/tier edits."
                },
                "percentage": {
                  "type": "number",
                  "description": "Snapshotted percentage for percentage-type items"
                },
                "upgrade_applies_to": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Which cabinet categories this percentage upgrade applies to"
                },
                "catalog_item_id": {
                  "type": "string",
                  "description": "Reference to the BidItemCatalog item this line item was built from. Null/absent for custom/manual items."
                },
                "pricing_mode": {
                  "type": "string",
                  "enum": [
                    "fixed",
                    "tier_based"
                  ],
                  "description": "Snapshotted pricing mode of the source catalog item at the time the line item was added/refreshed"
                },
                "tier_rate_category": {
                  "type": "string",
                  "enum": [
                    "base",
                    "upper",
                    "tall"
                  ],
                  "description": "Snapshotted tier rate category used for tier-based pricing"
                },
                "plan_ann_id": {
                  "type": "string",
                  "description": "Plan annotation (highlight) id this line item was generated from, for live upsert keyed by mark"
                },
                "plan_ann_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "All plan annotation (highlight) ids absorbed into this merged line item \u2014 multiple highlights of the same item in a room merge into one row"
                },
                "manual_base": {
                  "type": "number",
                  "description": "Manually-entered quantity portion preserved when plan highlights were merged into this row; total Qty = manual_base + sum of tracked plan marks"
                },
                "sketch_insert_id": {
                  "type": "string",
                  "description": "Sketch symbol id this item was generated from (rollout inserts)"
                },
                "notes": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "proposal_rooms": {
      "type": "array",
      "description": "Room-based proposals only: one priced row per room (no LF, no catalog items). Optional rooms live here with is_optional=true so they are excluded from the Standard Total. Each room carries its own selection values and its upgrades nest under it via proposal_options.parent_room_id.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "room_name": {
            "type": "string",
            "description": "Room name, e.g. Kitchen"
          },
          "finish": {
            "type": "string",
            "description": "Wood type / finish shown in the Finish column, e.g. 'Paint Grade Perimeter / White Oak Island'. When empty, the finish column is filled from the room's selections (or the main selections when the room inherits them)."
          },
          "items_of_recognition": {
            "type": "string",
            "description": "Free-text description of what is included in this room (the proposal's Items of Recognition column)"
          },
          "price": {
            "type": "number",
            "description": "Room price. For optional rooms this is the price of adding the room."
          },
          "is_optional": {
            "type": "boolean",
            "default": false,
            "description": "True when this room is itself optional \u2014 listed under Options and excluded from the Standard Total"
          },
          "selected": {
            "type": "boolean",
            "default": false,
            "description": "Whether an optional room is currently selected on the proposal"
          },
          "use_main_selections": {
            "type": "boolean",
            "default": true,
            "description": "True (default) = this room inherits the proposal-level selections. False = the room uses its own values stored in `selections`."
          },
          "selections": {
            "type": "object",
            "description": "Per-room selection values used only when use_main_selections is false. Prefilled from the main selections when the room is switched to its own, so only the differences need entering.",
            "properties": {
              "cabinet_style": {
                "type": "string"
              },
              "wood_species": {
                "type": "string"
              },
              "finish": {
                "type": "string",
                "description": "Room-specific finish / color; fills the Finish column when the room row's finish is left blank"
              },
              "door_style": {
                "type": "string"
              },
              "handles": {
                "type": "string"
              },
              "drawerbox": {
                "type": "string"
              },
              "drawer_glides": {
                "type": "string"
              },
              "hinges": {
                "type": "string"
              },
              "notes": {
                "type": "string",
                "description": "Room-specific notes printed under the room on the proposal"
              }
            }
          },
          "sort_order": {
            "type": "number",
            "description": "Display order within the Standard table / Options list"
          }
        }
      }
    },
    "proposal_options": {
      "type": "array",
      "description": "Room-based proposals only: upgrades and add-ons. An option may belong to a room (parent_room_id) and may be priced as a delta on that room or as an absolute amount. Options with a parent_room_id print nested beneath that room.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "description": "Option title, e.g. 'Upgrade to soft-close undermount drawers'"
          },
          "description": {
            "type": "string",
            "description": "What this option includes"
          },
          "price": {
            "type": "number",
            "description": "Option price"
          },
          "price_mode": {
            "type": "string",
            "enum": [
              "delta",
              "absolute"
            ],
            "default": "delta",
            "description": "delta = added on top of the room/job price (+$1,250); absolute = the option's own price"
          },
          "parent_room_id": {
            "type": "string",
            "description": "ID of the proposal_rooms row this option upgrades. Empty for job-level options."
          },
          "parent_room_name": {
            "type": "string",
            "description": "Room name snapshot, so the option still reads correctly if the room is renamed or removed"
          },
          "default_selected": {
            "type": "boolean",
            "default": false,
            "description": "Whether this option starts out selected on the proposal (usually no)"
          },
          "selected": {
            "type": "boolean",
            "default": false,
            "description": "Whether this option is currently selected on the proposal"
          },
          "sort_order": {
            "type": "number",
            "description": "Display order within the Options section"
          }
        }
      }
    },
    "bid_files": {
      "type": "array",
      "description": "Attached files (recordings, PDFs, drawings, etc.)",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      }
    },
    "total": {
      "type": "number"
    },
    "total_lf": {
      "type": "number"
    },
    "plan_scale_px_per_ft": {
      "type": "number",
      "description": "Detected/calibrated plan scale in natural-px per real foot, used to convert manual plan-mark lengths into linear feet for 'Price from Plan Marks' pricing"
    },
    "ai_notes": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "plan_annotations": {
      "type": "array",
      "description": "Saved drawing annotations on the plan",
      "items": {
        "type": "object"
      }
    },
    "client_visible": {
      "type": "boolean",
      "default": false,
      "description": "Whether this estimate/bid is shared with the client in their portal Proposal tab"
    }
  },
  "required": [
    "project_name"
  ]
}