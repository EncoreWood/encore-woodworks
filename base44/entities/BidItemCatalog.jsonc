{
  "name": "BidItemCatalog",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Item display name"
    },
    "cabinet_category": {
      "type": "string",
      "description": "Category key (references a BidCategory.key). Stored as a free string because categories are user-managed."
    },
    "measure_type": {
      "type": "string",
      "enum": [
        "lf",
        "qty",
        "sqft",
        "both",
        "percentage"
      ],
      "default": "lf",
      "description": "Linear feet, quantity, square feet, both, or percentage"
    },
    "pricing_mode": {
      "type": "string",
      "enum": [
        "fixed",
        "tier_based"
      ],
      "default": "fixed",
      "description": "Fixed = always use default_price/default_percentage. Tier-based = dynamically pull the $/LF rate from the bid's selected Cabinet Style/Tier matching tier_rate_category (only applied when building NEW line items or refreshing a bid to current pricing; existing bid line items keep their snapshotted price)."
    },
    "tier_rate_category": {
      "type": "string",
      "enum": [
        "base",
        "upper",
        "tall"
      ],
      "description": "For tier-based items: which $/LF rate (Base/Upper/Tall) of the selected tier to use. If omitted, inferred from cabinet_category when it is base/upper/tall."
    },
    "default_price": {
      "type": "number",
      "description": "Default unit price (used for fixed-price items)"
    },
    "default_percentage": {
      "type": "number",
      "description": "Default percentage value for percentage-type items"
    },
    "upgrade_applies_to": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Which cabinet categories this upgrade percentage applies to (base, upper, tall)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this item is shown in bids"
    },
    "sort_order": {
      "type": "number"
    }
  },
  "required": [
    "name"
  ]
}