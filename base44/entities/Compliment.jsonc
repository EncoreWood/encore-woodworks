{
  "name": "Compliment",
  "type": "object",
  "properties": {
    "from": {
      "type": "string",
      "description": "Who is giving the compliment"
    },
    "to": {
      "type": "string",
      "description": "Who the compliment is for"
    },
    "message": {
      "type": "string",
      "description": "The compliment message"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of the compliment"
    },
    "submitted_at": {
      "type": "string",
      "description": "ISO timestamp of submission"
    },
    "share_in_meeting": {
      "type": "boolean",
      "default": false,
      "description": "Whether to share this in the morning meeting"
    },
    "is_announced": {
      "type": "boolean",
      "default": false,
      "description": "True once this well done has been announced in the morning meeting. Announced well dones drop off the meeting widget for every user."
    },
    "announced_at": {
      "type": "string",
      "description": "ISO timestamp of when it was marked announced (nullable)"
    }
  },
  "required": [
    "from",
    "to",
    "message",
    "date"
  ]
}