{
  "name": "SelectionOption",
  "type": "object",
  "properties": {
    "field_key": {
      "type": "string",
      "description": "Which selection field this option belongs to (e.g. cabinet_style, door_style, wood_species, finish)"
    },
    "value": {
      "type": "string",
      "description": "The option text shown in the dropdown"
    },
    "removed": {
      "type": "boolean",
      "default": false,
      "description": "For built-in default options the team hid: true means hidden from the dropdown. Custom additions always have this false."
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "field_key",
    "value"
  ]
}