{
  "name": "EndOfDayReview",
  "type": "object",
  "properties": {
    "submitted_by": {
      "type": "string",
      "description": "Full name of the user who submitted"
    },
    "submitted_by_email": {
      "type": "string",
      "description": "Email of the user who submitted"
    },
    "submitted_at": {
      "type": "string",
      "description": "ISO timestamp of submission"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of the review (YYYY-MM-DD)"
    },
    "day_rating": {
      "type": "string",
      "enum": [
        "great",
        "good",
        "fuck_alright",
        "okay",
        "bad",
        "terrible"
      ],
      "description": "Overall day rating. Null when the employee skipped the rating."
    },
    "reason": {
      "type": "string",
      "description": "Why was it good or bad?"
    },
    "last_cabinet": {
      "type": "string",
      "description": "Legacy: which cabinet did you end on? No longer asked \u2014 card move history tracks this."
    },
    "area_clean": {
      "type": "boolean",
      "default": false,
      "description": "Is the work area clean?"
    },
    "area_notes": {
      "type": "string",
      "description": "Notes about cleanliness if not clean"
    },
    "comments": {
      "type": "string",
      "description": "General free-text comments from the employee"
    },
    "accomplishments": {
      "type": "string",
      "description": "Legacy: what was accomplished today? No longer asked \u2014 production points track this."
    },
    "report_links": {
      "type": "array",
      "description": "Struggles, well dones and mistakes reported with this review \u2014 the link back to each source record",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "struggle",
              "compliment",
              "mistake"
            ]
          },
          "id": {
            "type": "string",
            "description": "ID of the created record"
          },
          "text": {
            "type": "string",
            "description": "Snapshot of what was reported"
          }
        }
      }
    },
    "blockers": {
      "type": "string",
      "description": "Anything blocking progress?"
    },
    "tomorrow_plan": {
      "type": "string",
      "description": "What is the plan for tomorrow?"
    }
  },
  "required": [
    "submitted_by",
    "submitted_at",
    "date"
  ]
}