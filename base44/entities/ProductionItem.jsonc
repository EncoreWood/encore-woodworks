{
  "name": "ProductionItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Item name or description"
    },
    "type": {
      "type": "string",
      "enum": [
        "cabinet",
        "cut",
        "misc",
        "pickup",
        "end_panel"
      ],
      "description": "Type of production item"
    },
    "cabinet_style": {
      "type": "string",
      "description": "Cabinet style for this item's room (style_key or label), inherited from the bid room override so the shop knows which style to build without checking the bid"
    },
    "wood_type": {
      "type": "string",
      "description": "Wood species for THIS card only (e.g. Beech, Maple) \u2014 read from the card's own PDF cut list, not inherited from the room selections"
    },
    "finish": {
      "type": "string",
      "description": "Finish/color for THIS card only (e.g. Painted \u00b7 Fudge Room) \u2014 read from the card's own PDF cut list, not inherited from the room selections"
    },
    "stage": {
      "type": "string",
      "enum": [
        "cut",
        "face_frame",
        "spray",
        "build",
        "complete",
        "on_hold",
        "missing"
      ],
      "enumColors": [
        "blue",
        "purple",
        "pink",
        "yellow",
        "green",
        "gray",
        "red"
      ],
      "default": "face_frame",
      "description": "Current production stage. 'missing' is a HELD state, not a production stage: a missing-items card waits there (earning no points, in no column) until someone sends it to production."
    },
    "sort_order": {
      "type": "number",
      "description": "Sort order within a column \u2014 new/moved cards get max+1 (bottom of the list); urgent toggles slot after existing urgent cards"
    },
    "is_urgent": {
      "type": "boolean",
      "default": false,
      "description": "Marked urgent on the production board \u2014 urgent cards float to the top of their column, in the order they became urgent"
    },
    "is_being_worked": {
      "type": "boolean",
      "default": false,
      "description": "Card is flagged as currently being worked on \u2014 shown in the column's 'Currently Working On' section"
    },
    "is_job_info": {
      "type": "boolean",
      "default": false,
      "description": "If true, this item lives only in the Job Info tab and is not shown on the Production board"
    },
    "linked_production_item_id": {
      "type": "string",
      "description": "ID of the production board card this Job Info card is linked to"
    },
    "parent_card_id": {
      "type": "string",
      "description": "ID of the parent production card this child card (missing-items or cut) was split from"
    },
    "missing_details": {
      "type": "array",
      "description": "For missing-items cards: the reported missing parts shown on the card face",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "What is missing, e.g. Door Front"
          },
          "qty": {
            "type": "number",
            "description": "Quantity"
          },
          "width": {
            "type": "string",
            "description": "Width (fraction string)"
          },
          "length": {
            "type": "string",
            "description": "Length (fraction string)"
          },
          "material": {
            "type": "string",
            "description": "Material spec"
          },
          "finish": {
            "type": "string",
            "description": "Finish spec"
          },
          "missing_item_id": {
            "type": "string",
            "description": "ID of the linked MissingItem record"
          }
        }
      }
    },
    "is_cut_child": {
      "type": "boolean",
      "default": false,
      "description": "True when this card is a cut child spawned from a parent card with 'Send to Cut'. Cut children merge back into the parent when they complete."
    },
    "cut_details": {
      "type": "object",
      "description": "For cut child cards: what needs to be cut, shown on the card face",
      "properties": {
        "description": {
          "type": "string",
          "description": "Description of the part(s) to cut, e.g. Island wing panel 12 x 34"
        },
        "qty": {
          "type": "number",
          "description": "Quantity to cut"
        },
        "material": {
          "type": "string",
          "description": "Material / wood type for the cut parts"
        },
        "finish": {
          "type": "string",
          "description": "Finish for the cut parts"
        }
      }
    },
    "cut_plan_reference": {
      "type": "object",
      "description": "Where on the plan this cut card came from \u2014 set when the cut was created from the plan viewer with 'Cut Parts'",
      "properties": {
        "page_number": {
          "type": "number",
          "description": "PDF page of the plan the cut was spotted on"
        },
        "rect": {
          "type": "object",
          "description": "Marked area on that page, normalized 0\u20131 against the page size",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "w": {
              "type": "number"
            },
            "h": {
              "type": "number"
            }
          }
        },
        "image_url": {
          "type": "string",
          "description": "Cropped snapshot of the marked plan area, so the shop can see exactly what to cut"
        }
      }
    },
    "is_merged": {
      "type": "boolean",
      "default": false,
      "description": "True when a cut child has been absorbed back into its parent. Merged cards keep their record, stage log and points but no longer appear on the Production board or in room counts."
    },
    "merged_into_card_id": {
      "type": "string",
      "description": "ID of the parent card a merged cut child was absorbed into"
    },
    "merged_at": {
      "type": "string",
      "description": "ISO timestamp of when the cut child merged back into its parent"
    },
    "cut_merge_log": {
      "type": "array",
      "description": "On a parent card: audit trail of cut children that were completed and merged back into it",
      "items": {
        "type": "object",
        "properties": {
          "cut_card_id": {
            "type": "string",
            "description": "ID of the merged cut child card"
          },
          "cut_card_name": {
            "type": "string",
            "description": "Name of the merged cut child card"
          },
          "description": {
            "type": "string",
            "description": "What was cut"
          },
          "qty": {
            "type": "number",
            "description": "Quantity that was cut"
          },
          "completed_by": {
            "type": "string",
            "description": "Name or email of the user who finished the cut"
          },
          "completed_at": {
            "type": "string",
            "description": "ISO timestamp of when the cut completed"
          }
        }
      }
    },
    "project_id": {
      "type": "string",
      "description": "Reference to Project ID"
    },
    "project_name": {
      "type": "string",
      "description": "Project name for reference"
    },
    "room_name": {
      "type": "string",
      "description": "Room name for reference"
    },
    "pickup_item_id": {
      "type": "string",
      "description": "Reference to PickupItem ID if this card was created from the pickup list"
    },
    "pts": {
      "type": "number",
      "description": "Card-level point value (used when no files are attached, e.g. pickup items)"
    },
    "misc_items": {
      "type": "array",
      "description": "For Misc-type cards: selected sub-items (Base, Crown, Toe Kick, Skin, 1/4 Scribe, Cleat) each with qty, wood type, finish and notes",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Sub-item name, e.g. Toe Kick"
          },
          "qty": {
            "type": "number",
            "description": "Quantity"
          },
          "wood_type": {
            "type": "string",
            "description": "Wood species"
          },
          "finish": {
            "type": "string",
            "description": "Finish spec"
          },
          "notes": {
            "type": "string",
            "description": "Notes for this sub-item"
          }
        }
      }
    },
    "columns_visited": {
      "type": "string",
      "default": "[]",
      "description": "JSON array string of column stage names this item has already been to. Never shrinks."
    },
    "total_points": {
      "type": "number",
      "default": 0,
      "description": "The card's point value. Written ONLY by an explicit save from the Edit Production Item modal, or once at card creation from the uploaded PDF. Never recalculated in the background; stage moves snapshot it onto the move instead of rewriting it."
    },
    "points_audit_log": {
      "type": "array",
      "description": "Who changed this card's points, from what value, to what value and when \u2014 one row per explicit point edit",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "number",
            "description": "Point value before the change"
          },
          "to": {
            "type": "number",
            "description": "Point value after the change"
          },
          "by": {
            "type": "string",
            "description": "Name or email of the person who changed it"
          },
          "at": {
            "type": "string",
            "description": "ISO timestamp of the change"
          }
        }
      }
    },
    "pts_logged": {
      "type": "number",
      "description": "Points value recorded when first moved to complete. Never changes after first completion."
    },
    "pts_logged_date": {
      "type": "string",
      "format": "date",
      "description": "The date pts_logged was recorded (used for complete day/week/month tallies)"
    },
    "stage_pts_log": {
      "type": "array",
      "description": "Legacy log of pts per stage exit. Superseded by ColumnMoveLog.",
      "items": {
        "type": "object",
        "properties": {
          "from_stage": {
            "type": "string"
          },
          "pts": {
            "type": "number"
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "stage_move_log": {
      "type": "array",
      "description": "Timestamp log of every stage transition. Each entry snapshots the card's point value at the moment of the move, so history can never be rewritten by a later point edit.",
      "items": {
        "type": "object",
        "properties": {
          "from_stage": {
            "type": "string",
            "description": "Stage moved from"
          },
          "to_stage": {
            "type": "string",
            "description": "Stage moved to"
          },
          "moved_by": {
            "type": "string",
            "description": "Full name or email of the user who moved it"
          },
          "timestamp": {
            "type": "string",
            "description": "ISO datetime of the move"
          },
          "points": {
            "type": "number",
            "description": "The card's point value at the moment of this move. Every stage/day/week/month total uses this snapshot; older entries without it fall back to total_points."
          }
        }
      }
    },
    "sent_back_for_missing": {
      "type": "boolean",
      "default": false,
      "description": "Legacy flag: true when this card was sent back into production stages because of a missing-item report. New reports create a separate linked missing-items card instead."
    },
    "glb_url": {
      "type": "string"
    },
    "glb_name": {
      "type": "string"
    },
    "sketch_url": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "description": "Item files (photos, drawings, etc.)",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "pts": {
            "type": "number",
            "description": "Point value for this file. Kept equal to the card's PTS on a single-file card."
          },
          "annotations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "description": "Date the item was moved to the complete stage"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type"
  ]
}