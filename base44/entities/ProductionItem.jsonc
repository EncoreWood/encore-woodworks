{
  "name": "ProductionItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Item name or description"
    },
    "type": {
      "type": "string",
      "enum": [
        "cabinet",
        "cut",
        "misc",
        "pickup"
      ],
      "description": "Type of production item"
    },
    "cabinet_style": {
      "type": "string",
      "description": "Cabinet style for this item's room (style_key or label), inherited from the bid room override so the shop knows which style to build without checking the bid"
    },
    "stage": {
      "type": "string",
      "enum": [
        "cut",
        "face_frame",
        "spray",
        "build",
        "complete",
        "on_hold"
      ],
      "default": "face_frame",
      "description": "Current production stage"
    },
    "sort_order": {
      "type": "number",
      "description": "Sort order within a column \u2014 new/moved cards get max+1 (bottom of the list); urgent toggles slot after existing urgent cards"
    },
    "is_urgent": {
      "type": "boolean",
      "default": false,
      "description": "Marked urgent on the production board \u2014 urgent cards float to the top of their column, in the order they became urgent"
    },
    "is_being_worked": {
      "type": "boolean",
      "default": false,
      "description": "Card is flagged as currently being worked on \u2014 shown in the column's 'Currently Working On' section"
    },
    "is_job_info": {
      "type": "boolean",
      "default": false,
      "description": "If true, this item lives only in the Job Info tab and is not shown on the Production board"
    },
    "linked_production_item_id": {
      "type": "string",
      "description": "ID of the production board card this Job Info card is linked to"
    },
    "parent_card_id": {
      "type": "string",
      "description": "ID of the parent production card this missing-items card was split from"
    },
    "missing_details": {
      "type": "array",
      "description": "For missing-items cards: the reported missing parts shown on the card face",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "What is missing, e.g. Door Front"
          },
          "qty": {
            "type": "number",
            "description": "Quantity"
          },
          "width": {
            "type": "string",
            "description": "Width (fraction string)"
          },
          "length": {
            "type": "string",
            "description": "Length (fraction string)"
          },
          "material": {
            "type": "string",
            "description": "Material spec"
          },
          "finish": {
            "type": "string",
            "description": "Finish spec"
          },
          "missing_item_id": {
            "type": "string",
            "description": "ID of the linked MissingItem record"
          }
        }
      }
    },
    "project_id": {
      "type": "string",
      "description": "Reference to Project ID"
    },
    "project_name": {
      "type": "string",
      "description": "Project name for reference"
    },
    "room_name": {
      "type": "string",
      "description": "Room name for reference"
    },
    "pickup_item_id": {
      "type": "string",
      "description": "Reference to PickupItem ID if this card was created from the pickup list"
    },
    "pts": {
      "type": "number",
      "description": "Card-level point value (used when no files are attached, e.g. pickup items)"
    },
    "misc_items": {
      "type": "array",
      "description": "For Misc-type cards: selected sub-items (Base, Crown, Toe Kick, Skin, 1/4 Scribe, Cleat) each with qty, wood type, finish and notes",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Sub-item name, e.g. Toe Kick"
          },
          "qty": {
            "type": "number",
            "description": "Quantity"
          },
          "wood_type": {
            "type": "string",
            "description": "Wood species"
          },
          "finish": {
            "type": "string",
            "description": "Finish spec"
          },
          "notes": {
            "type": "string",
            "description": "Notes for this sub-item"
          }
        }
      }
    },
    "columns_visited": {
      "type": "string",
      "default": "[]",
      "description": "JSON array string of column stage names this item has already been to. Never shrinks."
    },
    "total_points": {
      "type": "number",
      "default": 0,
      "description": "Running total of points earned by this item across all column visits"
    },
    "pts_logged": {
      "type": "number",
      "description": "Points value recorded when first moved to complete. Never changes after first completion."
    },
    "pts_logged_date": {
      "type": "string",
      "format": "date",
      "description": "The date pts_logged was recorded (used for complete day/week/month tallies)"
    },
    "stage_pts_log": {
      "type": "array",
      "description": "Legacy log of pts per stage exit. Superseded by ColumnMoveLog.",
      "items": {
        "type": "object",
        "properties": {
          "from_stage": {
            "type": "string"
          },
          "pts": {
            "type": "number"
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "stage_move_log": {
      "type": "array",
      "description": "Timestamp log of every stage transition.",
      "items": {
        "type": "object",
        "properties": {
          "from_stage": {
            "type": "string",
            "description": "Stage moved from"
          },
          "to_stage": {
            "type": "string",
            "description": "Stage moved to"
          },
          "moved_by": {
            "type": "string",
            "description": "Full name or email of the user who moved it"
          },
          "timestamp": {
            "type": "string",
            "description": "ISO datetime of the move"
          }
        }
      }
    },
    "sent_back_for_missing": {
      "type": "boolean",
      "default": false,
      "description": "Legacy flag: true when this card was sent back into production stages because of a missing-item report. New reports create a separate linked missing-items card instead."
    },
    "glb_url": {
      "type": "string"
    },
    "glb_name": {
      "type": "string"
    },
    "sketch_url": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "description": "Item files (photos, drawings, etc.)",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "pts": {
            "type": "number",
            "description": "Point value for this file"
          },
          "annotations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "description": "Date the item was moved to the complete stage"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type"
  ]
}